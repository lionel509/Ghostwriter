{
  "name": "ghostwriter",
  "version": "0.1.0",
  "description": "Obsidian plugin: inline ghost-text completion from a local model.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "install-local": "node esbuild.config.mjs && node install.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.10.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2"
  }
}
